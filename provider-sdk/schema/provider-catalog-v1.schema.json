{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netvplayer.example/schema/provider-catalog-v1.schema.json",
  "title": "NetVplayer Provider migration catalog v1",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "provider_id", "name", "runtime", "original_api", "original_ext", "original_jar",
      "original_spider", "capabilities", "dependencies", "license", "source", "compatibility",
      "runner_verified", "parser_verified", "runtime_packaging", "network",
      "playback_verified", "distribution_ready", "reason"
    ],
    "properties": {
      "provider_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
      "name": { "type": "string", "minLength": 1 },
      "runtime": { "enum": ["java", "js", "quickjs", "python", "android-dex"] },
      "original_api": { "type": ["string", "null"] },
      "original_ext": { "type": ["string", "null"] },
      "original_jar": { "type": ["string", "null"] },
      "original_spider": { "type": ["string", "null"] },
      "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
      "dependencies": { "type": "array", "items": { "type": "string" } },
      "license": { "type": ["string", "null"] },
      "source": { "type": ["string", "null"] },
      "compatibility": { "enum": ["compatible", "partial", "needs-port", "unsupported", "blocked-license"] },
      "runner_verified": { "type": ["boolean", "null"] },
      "parser_verified": { "type": ["boolean", "null"] },
      "runtime_packaging": { "enum": ["passed", "poc-only", "host-dependent", "untested", "not-applicable"] },
      "network": { "enum": ["usable", "network-blocked", "empty", "configuration", "untested"] },
      "playback_verified": { "type": "boolean" },
      "distribution_ready": { "type": "boolean" },
      "reason": { "type": ["string", "null"] }
    },
    "additionalProperties": false
  }
}
