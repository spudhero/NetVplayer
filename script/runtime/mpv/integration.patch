+static void feed_eac3(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    if (p->reload_requested)
+        return;
+    if (p->renderer.status == AVQueuedSampleBufferRenderingStatusFailed) {
+        compressed_error(ao, "system decoder rejected the compressed stream");
+        return;
+    }
+    int64_t now_av = CMTimeGetNanoseconds([p->synchronizer currentTime]);
+    int64_t end_av = MPMAX(p->end_time_av, now_av);
+    int request = (NV_EAC3_BURST_BYTES - p->burst_bytes) / ao->sstride;
+    int64_t duration = CMTimeGetNanoseconds(CMTimeMake(NV_EAC3_BURST_FRAMES, ao->samplerate));
+    void *data[] = {p->burst + p->burst_bytes};
+    bool eof = false;
+    int count = ao_read_data(ao, data, request,
+        end_av - now_av + mp_time_ns() + duration, &eof, false, true);
+    p->burst_bytes += count * ao->sstride;
+    if (p->burst_bytes < NV_EAC3_BURST_BYTES) {
+        if (eof) {
+            if (p->burst_bytes)
+                MP_WARN(ao, "Discarded incomplete final EAC3 burst.\n");
+            p->burst_bytes = 0;
+            [p->renderer stopRequestingMediaData];
+            ao_stop_streaming(ao);
+        }
+        return;
+    }
+    struct nv_eac3_packet packet;
+    bool valid = nv_eac3_unpack(p->burst, sizeof(p->burst), &packet);
+    p->burst_bytes = 0;
+    if (!valid || packet.rate * 4 != ao->samplerate) {
+        compressed_error(ao, "invalid IEC 61937 EAC3 packet or clock rate");
+        return;
+    }
+    if (!p->format_description) {
+        bool joc = false;
+        p->format_description = nv_eac3_format(&packet, &joc);
+        atomic_store(&p->joc, joc);
+        if (!p->format_description) {
+            compressed_error(ao, "cannot construct original EAC3 format description");
+            return;
+        }
+        const AudioStreamBasicDescription *asbd = CMAudioFormatDescriptionGetStreamBasicDescription(p->format_description);
+        atomic_store(&p->source_rate, asbd->mSampleRate);
+        atomic_store(&p->source_channels, asbd->mChannelsPerFrame);
+        MP_INFO(ao, "Native EAC3 renderer: %.0f Hz, %u channels; original compressed payload retained.\n",
+                asbd->mSampleRate, asbd->mChannelsPerFrame);
+    }
+    CMBlockBufferRef block = NULL;
+    CMSampleBufferRef sample = NULL;
+    OSStatus err = CMBlockBufferCreateWithMemoryBlock(NULL, NULL, packet.size,
+        NULL, NULL, 0, packet.size, 0, &block);
+    if (err == noErr)
+        err = CMBlockBufferReplaceDataBytes(packet.data, block, 0, packet.size);
+    AudioStreamPacketDescription desc = {
+        .mStartOffset = 0, .mVariableFramesInPacket = packet.frames,
+        .mDataByteSize = (UInt32)packet.size,
+    };
+    if (err == noErr)
+        err = CMAudioSampleBufferCreateReadyWithPacketDescriptions(NULL, block,
+            p->format_description, 1, CMTimeFromNanoseconds(end_av), &desc, &sample);
+    if (err == noErr) {
+        [p->renderer enqueueSampleBuffer:sample];
+        p->end_time_av = end_av + CMTimeGetNanoseconds(CMTimeMake(packet.frames, packet.rate));
+        p->compressed_packets++;
+        p->compressed_bytes += packet.size;
+        if (p->compressed_packets == 1 || p->compressed_packets % 300 == 0)
+            MP_INFO(ao, "Native EAC3 enqueued packets=%llu end=%.3f status=%ld\n",
+                (unsigned long long)p->compressed_packets, p->end_time_av / 1e9,
+                (long)p->renderer.status);
+    } else {
+        compressed_error(ao, "cannot enqueue compressed sample");
+    }
+    if (sample) CFRelease(sample);
+    if (block) CFRelease(block);
+}
