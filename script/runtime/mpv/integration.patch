+// Shares mpv's AO clock, pause/seek lifecycle and selected demux stream.
+// A compressed sample is never sent to an ordinary PCM hardware buffer.
+static void compressed_error(struct ao *ao, const char *reason)
+{
+    struct priv *p = ao->priv;
+    [p->renderer stopRequestingMediaData];
+    if (!p->reload_requested) {
