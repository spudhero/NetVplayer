+static bool pcm_physical_candidate(const AudioStreamBasicDescription *requested,
+                                   const AudioStreamRangedDescription *ranged,
+                                   AudioStreamBasicDescription *candidate)
+{
+    *candidate = ranged->mFormat;
+    // This shared AO carries decoded PCM. Encoded formats are negotiated only
+    // by the separate strict compressed AO, never by this best-effort switch.
+    if (candidate->mFormatID != kAudioFormatLinearPCM ||
+        !candidate->mChannelsPerFrame ||
+        candidate->mChannelsPerFrame > MP_NUM_CHANNELS)
+        return false;
