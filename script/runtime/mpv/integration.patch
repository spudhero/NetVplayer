+static void fallback_compressed_audio(struct MPContext *mpctx)
+{
+    struct ao_chain *chain = mpctx->ao_chain;
+    if (!chain || !chain->track || !chain->track->dec || !chain->spdif_passthrough)
+        return;
+    MP_WARN(mpctx, "Compressed audio sink failed; restoring synchronized PCM output.\n");
+    ao_reset(mpctx->ao);
+    uninit_audio_out(mpctx);
+    chain->spdif_passthrough = false;
+    chain->spdif_failed = true;
+    mp_decoder_wrapper_set_spdif_flag(chain->track->dec, false);
+    if (!mp_decoder_wrapper_reinit(chain->track->dec)) {
+        error_on_track(mpctx, chain->track);
+        return;
+    }
+    reinit_audio_filters(mpctx);
+    reset_audio_state(mpctx);
+    mp_output_chain_reset_harder(chain->filter);
