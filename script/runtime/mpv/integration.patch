+static int mp_property_netvplayer_audio(void *ctx, struct m_property *prop,
+                                        int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    int valid = m_property_read_sub_validate(ctx, prop, action, arg);
+    if (valid != M_PROPERTY_VALID)
+        return valid;
+    struct ao_native_audio_status status;
+    if (!mpctx->ao || ao_control(mpctx->ao, AOCONTROL_GET_NATIVE_AUDIO_STATUS, &status) != CONTROL_OK)
+        return M_PROPERTY_UNAVAILABLE;
+    struct m_sub_property props[] = {
+        {"samplerate", SUB_PROP_INT(status.rate)},
+        {"channels", SUB_PROP_INT(status.channels)},
+        {"renderer-state", SUB_PROP_INT(status.renderer_state)},
+        {"joc", SUB_PROP_BOOL(status.joc)},
+        {"spatial-allowed", SUB_PROP_BOOL(status.spatial_allowed)},
+        {"renderer-muted", SUB_PROP_BOOL(status.muted)},
+        {"renderer-volume", SUB_PROP_FLOAT(status.volume)},
+        {"packets", SUB_PROP_INT64(status.packets)},
+        {"payload-bytes", SUB_PROP_INT64(status.payload_bytes)},
+        {"generation", SUB_PROP_INT64(status.generation)},
+        {0}
+    };
+    return m_property_read_sub(props, action, arg);
+}
+
+#if HAVE_NETVPLAYER_ATMOS
+#include "audio/decode/ad_truehd_objects.h"
+static int mp_property_netvplayer_objects(void *ctx, struct m_property *prop, int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    int valid = m_property_read_sub_validate(ctx, prop, action, arg);
+    if (valid != M_PROPERTY_VALID) return valid;
+    struct track *track = mpctx->current_track[0][STREAM_AUDIO];
+    struct nv_object_audio_status s;
+    if (!track || !track->dec || mp_decoder_wrapper_control(track->dec, ADCTRL_GET_OBJECT_AUDIO_STATUS, &s) != CONTROL_OK)
+        return M_PROPERTY_UNAVAILABLE;
+    struct m_sub_property props[] = {
+        {"mode", SUB_PROP_INT(s.mode)}, {"samplerate", SUB_PROP_INT(s.rate)},
+        {"presentation", SUB_PROP_INT(s.presentation)}, {"elements", SUB_PROP_INT(s.elements)},
+        {"has-objects", SUB_PROP_BOOL(s.has_objects)}, {"metadata-seen", SUB_PROP_BOOL(s.metadata_seen)},
+        {"frames", SUB_PROP_INT64(s.frames)}, {"object-blocks", SUB_PROP_INT64(s.object_blocks)},
+        {"metadata-updates", SUB_PROP_INT64(s.metadata_updates)}, {"fallback-blocks", SUB_PROP_INT64(s.fallback_blocks)},
+        {"decode-errors", SUB_PROP_INT64(s.decode_errors)}, {"sync-errors", SUB_PROP_INT64(s.sync_errors)},
+        {"metadata-errors", SUB_PROP_INT64(s.metadata_errors)}, {"binaural-frames", SUB_PROP_INT64(s.binaural_frames)},
+        {"tracking-requested", SUB_PROP_BOOL(s.tracking_requested)}, {"tracking-active", SUB_PROP_BOOL(s.tracking_active)},
+        {"poses", SUB_PROP_INT64(s.poses)}, {"pose-age", SUB_PROP_DOUBLE(s.pose_age)}, {0}
+    };
+    return m_property_read_sub(props, action, arg);
+}
+#endif
