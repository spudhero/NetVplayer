+    double min = ranged->mSampleRateRange.mMinimum;
+    double max = ranged->mSampleRateRange.mMaximum;
+    if (isfinite(min) && isfinite(max) && min > 0 && max >= min) {
+        // Some devices describe a continuous range with a zero or arbitrary
+        // nominal rate. Choose a supported rate from the range explicitly.
+        candidate->mSampleRate = MPCLAMP(requested->mSampleRate, min, max);
+    }
+    return isfinite(candidate->mSampleRate) && candidate->mSampleRate > 0;
+}
