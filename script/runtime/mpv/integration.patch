+
+// NetVplayer's optional ABI: high 32 bits are the contract version.
+// Audio capabilities describe implemented transports, not connected hardware.
+MPV_EXPORT uint64_t mpv_netvplayer_runtime_capabilities(void);
+MPV_EXPORT uint64_t mpv_netvplayer_runtime_capabilities(void)
+{
+    uint64_t result = (UINT64_C(1) << 32) | 3;
+#if HAVE_AVFOUNDATION
+    result |= 16;
+#endif
+#if HAVE_COREAUDIO
+    // Strict compressed transports, restorable PCM rate follow, DTS-HD HBR.
+    result |= 32 | 64 | 128 | 256;
+#endif
+#if HAVE_NETVPLAYER_ATMOS
+    result |= 512;
+#endif
+    return result;
+}
